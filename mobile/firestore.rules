rules_version = '2';

// Regras de segurança do Colecity (Cloud Firestore).
//
// O Firestore guarda só os dados do próprio usuário (doc 08, seção 8). Todo o domínio
// (ocorrências, participações, comentários, denúncias) fica na API C#, acessada pelo BFF.
// O BFF usa o Admin SDK, que não passa por estas regras: é ele que lê aparelhos e preferências
// para enviar o push e que usa as coleções internas (eventosProcessados, pushControle, bffUsuarios).
//
// Princípio: cada pessoa lê e escreve só o que é dela; todo o resto é negado.

service cloud.firestore {
  match /databases/{database}/documents {

    function ehDono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}: aceite dos termos e preferência de notificações.
    match /users/{uid} {
      allow read, delete: if ehDono(uid);
      allow create, update: if ehDono(uid)
        && request.resource.data.keys().hasOnly(['aceiteTermosVersao', 'notificationsEnabled', 'criadoEm', 'updatedAt'])
        && (!('aceiteTermosVersao' in request.resource.data) || request.resource.data.aceiteTermosVersao is string)
        && (!('notificationsEnabled' in request.resource.data) || request.resource.data.notificationsEnabled is bool);

      // occurrenceState/{ocorrenciaId}: silenciada e última visita (RN-NOT-04, RN-MIN-04).
      match /occurrenceState/{ocorrenciaId} {
        allow read, delete: if ehDono(uid);
        allow create, update: if ehDono(uid)
          && request.resource.data.keys().hasOnly(['muted', 'lastSeenAt'])
          && (!('muted' in request.resource.data) || request.resource.data.muted is bool);
      }

      // devices/{id}: tokens de push. Ninguém além do dono lê o token de um aparelho.
      match /devices/{aparelhoId} {
        allow read, write: if ehDono(uid);
      }
    }

    // Qualquer outro caminho (inclusive as coleções internas do BFF): negado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
