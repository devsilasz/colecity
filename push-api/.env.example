# Copie para `.env.local` (uso local com `vercel dev`) e cadastre os mesmos nomes na Vercel.
# Nunca versione valores reais.

# Firebase Admin SDK: valores do JSON da conta de serviço.
# Campo "project_id"
FIREBASE_PROJECT_ID=
# Campo "client_email"
FIREBASE_CLIENT_EMAIL=
# Campo "private_key" (com os \n)
FIREBASE_PRIVATE_KEY=

# Vercel Blob (fotos). Criada pela Vercel ao conectar o Blob ao projeto; para uso local,
# rode `npx vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=
