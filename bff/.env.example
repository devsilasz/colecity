# Copie para `.env.local` (uso local com `vercel dev`) e cadastre os mesmos nomes na Vercel.
# Nunca versione valores reais.

# Firebase Admin SDK (campos do JSON da conta de serviço)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# API de domínio (C#)
DOMINIO_URL=
DOMINIO_SERVICE_KEY=

# Vercel Blob (fotos)
BLOB_READ_WRITE_TOKEN=
BLOB_BASE_URL=
