{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "firestore",
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "EXPO_PUBLIC_PUSH_API_URL": "https://push-api-rho.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DATA_SOURCE": "firestore",
        "GOOGLE_SERVICES_JSON": "./google-services.json",
        "EXPO_PUBLIC_PUSH_API_URL": "https://push-api-rho.vercel.app"
      }
    }
  }
}
