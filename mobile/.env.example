# Copie para `.env.local` e preencha. Nunca versione valores reais.

# Fonte de dados: "bff" (padrão: BFF na Vercel + API C#) ou "mock" (tudo simulado no aparelho).
EXPO_PUBLIC_DATA_SOURCE=
# URL do BFF (pasta `bff/`, na Vercel), sem barra no final.
EXPO_PUBLIC_BFF_URL=
# Mock: chance (0 a 1) de cada chamada falhar, para testar telas de erro.
EXPO_PUBLIC_MOCK_ERROR_RATE=

# Somente para o build (development build / APK). Não são lidas pelo Expo Go.
# Chave da Maps SDK for Android. No build do EAS ela vem das variáveis do EAS, não deste arquivo.
API_KEY_MAPS=
GOOGLE_MAPS_IOS_API_KEY=
# Opcional: caminho do google-services.json (push/FCM). Padrão: ./google-services.json, se existir.
GOOGLE_SERVICES_JSON=
